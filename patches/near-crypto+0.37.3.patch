+/// Raw secp256k1 private key scalar (32 bytes).
+///
+/// Stored as raw bytes (rather than a live `k256::ecdsa::SigningKey`)
+/// because `SigningKey` deliberately does not implement `PartialEq`/`Eq` -
+/// comparing secret key material in non-constant-time is a foot-gun the
+/// type intentionally rules out. See [`secp256k1_signing_key`] for
+/// reconstructing the live key on demand.
+#[derive(Clone, PartialEq, Eq)]
+pub struct Secp256K1SecretKey(pub [u8; SECP256K1_SECRET_KEY_LENGTH]);
+
+impl Debug for Secp256K1SecretKey {
+    fn fmt(&self, f: &mut Formatter<'_>) -> Result<(), std::fmt::Error> {
+        // Avoid printing key material; show only the type tag.
+        f.write_str("Secp256K1SecretKey(<redacted>)")
+    }
+}
+
+/// Reconstruct the [`K256SigningKey`] from an already-validated raw scalar
+/// (see [`Secp256K1SecretKey`]). Only ever called with bytes that were
+/// already validated by `K256SigningKey::from_slice` when the
+/// `Secp256K1SecretKey` was constructed (`SecretKey::from_str`,
+/// `SecretKey::from_random`, or the deterministic seed helper in
+/// `test_utils.rs`), so this can't fail in practice.
+fn secp256k1_signing_key(secret_key: &Secp256K1SecretKey) -> K256SigningKey {
+    K256SigningKey::from_slice(&secret_key.0).expect("Secp256K1SecretKey is always a valid scalar")
+}
